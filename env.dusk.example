# Copy this file to .env.dusk.local and set the local MySQL credentials.
# The test runner refuses any database name other than labterpadu_dusk_test.
APP_NAME=LabDigitalFEB
APP_ENV=local
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=labterpadu_dusk_test
DB_USERNAME=labterpadu_test
DB_PASSWORD=change-me

BCRYPT_ROUNDS=4
CACHE_STORE=array
SESSION_DRIVER=cookie
QUEUE_CONNECTION=sync
MAIL_MAILER=array
FILESYSTEM_DISK=local
