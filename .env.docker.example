# LabDigitalFEB — Docker environment template
# Copy to `.env.docker` (gitignored) and fill in real values.
#   cp .env.docker.example .env.docker
#
# The app container reaches MySQL at host `db` (see docker-compose.yml),
# and stores session/queue/cache in the database. No Redis required.
#
# APP_KEY: leave EMPTY here — docker/entrypoint.sh generates one on first
# boot (php artisan key:generate --show). For a stable key across restarts,
# pre-generate and set it:  php artisan key:generate --show

APP_NAME="LabDigitalFEB"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:3333
FORCE_HTTPS=false

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_TIMEZONE=Asia/Jakarta
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# --- DB (matches compose `db` service; fail-fast, no defaults) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# --- Session / queue / cache (database driver) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Redis (present but unused by this app's default env; safe to ignore) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (log by default; configure for real deliveries) ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Vite dev server (only used in the `dev` overlay for HMR) ---
VITE_DEV_SERVER_URL=http://localhost:5173
# HMR host the *host browser* should connect to. Leave as localhost for local
# Docker use; set to your LAN IP for testing from other devices.
VITE_HMR_HOST=localhost

# --- Admin bootstrap account (consumed by DatabaseSeeder) ---
# Used to create the super_admin user (role overridden explicitly because
# `role` is not fillable). Set to real values; DatabaseSeeder falls back to
# demo credentials when these are empty.
ADMIN_NAME=CHANGE_ME
ADMIN_EMAIL=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME

# --- Composer / PHP built-in server tuning ---
# Raise above 1 in `prod` for more concurrent requests (matches PM2 single
# instance today, so default stays 1).
PHP_CLI_SERVER_WORKERS=1
APP_PORT=3333
DB_EXT_PORT=3307
VITE_PORT=5173