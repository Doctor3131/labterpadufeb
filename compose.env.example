# Copy to compose.env (ignored by Git). Compose intentionally fails until the
# image tag is set to the exact commit being rehearsed.
LABTERPADU_IMAGE_TAG=
# Rehearsal must use the storage copy and existing rehearsal DB volume.
LABTERPADU_STORAGE_APP_PATH=/home/fadil/labterpadu-rehearsal-storage/app
LABTERPADU_DB_VOLUME_NAME=labterpadu-production-db-data
# PHP/app containers cannot reach external networks during rehearsal.
# Set false only for production after reviewing required integrations.
LABTERPADU_BACKEND_INTERNAL=true
